# Copy to .env for local runs. Docker Compose reads this file if present.
# Every value below comes from the environment; nothing is defaulted in code.

APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://vizlify:vizlify@localhost:5432/vizlify
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Auth. dev = no keys (local + judges); clerk = hosted demo.
AUTH_MODE=dev
DEV_USER_EMAIL=demo@vizlify.space
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=
CLERK_JWT_KEY=

# PayPal. mock = in-process fake, no network and no keys (local + judges).
# sandbox = real sandbox calls; live = real money, allowed only in production.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_SECONDS=15
PAYPAL_MAX_RETRIES=2

# Payout spend caps, in the project currency.
PAYOUT_MAX_PER_ACTION=10000.00
PAYOUT_MAX_PER_DAY=50000.00

LLM_MODE=mock
DEMO_MODE=true
JOBS_MODE=inline
